# ===== 七零喵团队站点 后端环境配置 =====
# 复制为 .env 后按需修改（宝塔部署脚本会自动生成）
# 监听端口
PORT=8787
# 监听地址（127.0.0.1 仅本机 + nginx 反代；0.0.0.0 直接对外）
HOST=127.0.0.1
NODE_ENV=production

# JWT 签名密钥：生产务必改成随机长字符串
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d

# 初始管理员账号（仅首次初始化数据库时写入）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=qlm@2019

# 数据库文件（相对 backend 根目录或绝对路径）
DB_FILE=./data/team-site.db

# 上传目录与单文件大小上限（字节，默认 200MB）
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=209715200

# 允许跨域的前端来源，逗号分隔；留空表示同源部署（推荐）
ALLOWED_ORIGINS=

# 是否允许公开访问文件列表（1 公开 / 0 需登录）
PUBLIC_FILE_LIST=1

# 信任的代理层数（宝塔 nginx 反代时填 1）
TRUST_PROXY=1

# ===== 防 CC（应用层，与 nginx 的 limit_req/limit_conn 配合）=====
# 优先级：环境变量 > 后台「站点设置」中的同名项 > 内置默认值
# 下面留空或注释掉时，以后台设置为准；填写则强制生效（运维压测/应急时很有用）
# 总开关：1 开启（默认）/ 0 关闭
ANTICC_ENABLED=1
# 统计窗口（毫秒）
ANTICC_WINDOW_MS=60000
# 单 IP 每窗口允许的请求数，超出即封禁
ANTICC_MAX_REQUESTS=240
# 全局并发上限与单 IP 并发上限
ANTICC_MAX_CONCURRENT=200
ANTICC_MAX_PER_IP=16
# 封禁时长（秒）
ANTICC_BAN_SECONDS=600
# 白名单 IP（逗号分隔，支持前缀匹配如 10.0. ），适合放行监控/办公出口
ANTICC_WHITELIST=
# 携带有效登录 Token 的请求是否豁免（1 默认豁免，避免误伤后台与自动化脚本）
ANTICC_SKIP_TOKEN=1
