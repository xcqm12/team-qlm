# 统一换行符，避免 Windows 编辑的 .sh 传到 Linux 后报 bad interpreter / $'\r'
* text=auto

*.sh            text eol=lf
*.bash          text eol=lf
*.py            text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制资源不做换行转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.gz            binary
*.tar           binary
*.zip           binary
*.db            binary

# 在 GitHub 上把部署脚本识别为 Shell，便于语法高亮与检查
deploy/*.sh           linguist-language=Shell
deploy/lib/*.sh       linguist-language=Shell
deploy/tests/*.sh     linguist-language=Shell
tools/initd/*         linguist-language=Shell
